# Postgres from docker-compose.yml — owning role, used by migrations and seed.
DMOPS_DATABASE_URL=postgres://dmops:dmops@localhost:5434/dmops
# The API itself always connects as the least-privilege dmops_app role
# (derived from DMOPS_DATABASE_URL; override with DMOPS_DATABASE_URL_APP or
# DMOPS_APP_PASSWORD after rotating the role password in production).

# apps/api
DMOPS_API_PORT=8788

# Authentication mode: 'dev' (static tokens below, demo only) or 'oidc'.
# The API refuses to start without an explicit mode.
DMOPS_AUTH_MODE=dev
# dev-only bearer tokens; each maps to a seeded person and their study roles
DMOPS_TOKEN_DM_LEAD=dev-dmlead-token
DMOPS_TOKEN_DM_MANAGER=dev-manager-token
DMOPS_TOKEN_ANALYST=dev-analyst-token
DMOPS_TOKEN_PROGRAMMER=dev-programmer-token
DMOPS_TOKEN_BIOSTAT=dev-biostat-token
DMOPS_TOKEN_CLINOPS=dev-clinops-token
DMOPS_TOKEN_SPONSOR=dev-sponsor-token
DMOPS_TOKEN_QA=dev-qa-token
DMOPS_TOKEN_ADMIN=dev-admin-token

# DMOPS_AUTH_MODE=oidc — validate bearer JWTs from a real identity provider.
# Works with any OIDC-compliant IdP (Okta, Entra ID, Auth0, Keycloak, ...).
# DMOPS_OIDC_ISSUER=https://idp.example.com/realms/dmops
# DMOPS_OIDC_AUDIENCE=dmops-api
# DMOPS_OIDC_JWKS_URI=            # optional; defaults to issuer discovery
# DMOPS_OIDC_EMAIL_CLAIM=email    # claim that maps the token to a person record

# edc-core source adapter: a study_source row names the env var holding its
# study-scoped API key, so secrets never sit in the database.
# DMOPS_EDC_CORE_API_KEY_DEMO=edc-core-study-scoped-api-key

# github source adapter (ADR-0012): a study_source row names the repositories
# ("owner/name") and the env var holding a read-only token; same env
# indirection, no secrets in the database.
# DMOPS_GITHUB_TOKEN_DEMO=github-read-only-token
